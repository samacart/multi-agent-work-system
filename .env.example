# Copy to .env before running `docker compose up`.
# Secrets are read from the environment only; they are never stored in the database.

APP_ENV=local

DATABASE_URL=postgresql+asyncpg://postgres:postgres@postgres:5432/agent_work
REDIS_URL=redis://redis:6379/0

# Provider keys. Phase 1 makes no live model calls, so these may stay empty.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GITHUB_TOKEN=

EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIM=1536
DEFAULT_AGENT_MODEL=claude-sonnet

# Embedding provider. "hash" is offline, deterministic, and free - it carries
# real lexical signal but no synonymy. "openai" needs OPENAI_API_KEY.
EMBEDDING_PROVIDER=hash

# Memory extraction. "heuristic" is offline and rule-based.
MEMORY_EXTRACTOR=heuristic

# Ingestion limits and chunking.
MAX_SOURCE_FILE_BYTES=2000000
MAX_FOLDER_FILES=500
MAX_MEMORIES_PER_SOURCE=200
CHUNK_MAX_CHARS=1200
CHUNK_OVERLAP_CHARS=150

# Agent runtime adapter. Phase 1 ships "mock" only.
AGENT_RUNTIME=mock

# Host paths mounted read-only into api/worker as /data/sources.
SOURCES_DIR=./data/sources
ALLOWED_SOURCE_ROOTS=/data/sources

# Postgres container settings (must match DATABASE_URL).
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=agent_work

# Host ports.
API_PORT=8000
FRONTEND_PORT=5173
POSTGRES_PORT=5432
REDIS_PORT=6379

CORS_ORIGINS=http://localhost:5173
VITE_API_BASE_URL=http://localhost:8000
