# Copy to .env before running `docker compose up`.
# Secrets are read from the environment only; they are never stored in the database.

APP_ENV=local

DATABASE_URL=postgresql+asyncpg://postgres:postgres@postgres:5432/agent_work
REDIS_URL=redis://redis:6379/0

# Provider keys. Phase 1 makes no live model calls, so these may stay empty.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GITHUB_TOKEN=

EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIM=1536
DEFAULT_AGENT_MODEL=claude-sonnet-5

# Embedding provider:
#   hash    offline and deterministic, but lexical only - no paraphrase matching
#   ollama  real semantic embeddings from a local model, no credentials
#   openai  hosted, needs OPENAI_API_KEY
# For ollama: `ollama pull nomic-embed-text` and set EMBEDDING_MODEL to it.
# Shorter vectors are zero-padded to EMBEDDING_DIM, which leaves cosine
# similarity unchanged, so no migration is needed to switch.
EMBEDDING_PROVIDER=hash
OLLAMA_BASE_URL=http://localhost:11434

# Memory extraction. "heuristic" is offline and rule-based.
MEMORY_EXTRACTOR=heuristic

# Ingestion limits and chunking.
MAX_SOURCE_FILE_BYTES=2000000
MAX_FOLDER_FILES=500
MAX_MEMORIES_PER_SOURCE=200
CHUNK_MAX_CHARS=1200
CHUNK_OVERLAP_CHARS=150

# Agent runtime adapter:
#   mock         deterministic, offline, no provider (default)
#   llm          Anthropic or OpenAI, picked from DEFAULT_AGENT_MODEL
#   langgraph    the llm runtime inside a validate/repair state graph
#                (needs the optional extra: pip install '.[langgraph]')
#   claude_code  shells out to the Claude Code CLI. Uses your existing Claude
#                login - no API key. Requires host mode: ./scripts/run-host.sh
AGENT_RUNTIME=mock

# Claude Code host adapter.
CLAUDE_CODE_BINARY=claude
CLAUDE_CODE_CWD=
CLAUDE_CODE_TIMEOUT_SECONDS=600

# GitHub. Off unless GITHUB_TOKEN is set (or unauthenticated access is allowed,
# which works for public repos at a much lower rate limit). Creating pull
# requests needs a second, explicit opt-in AND an approved gate.
GITHUB_ALLOW_UNAUTHENTICATED=false
GITHUB_ALLOW_WRITES=false
GITHUB_MAX_FILES=200

# Host paths mounted read-only into api/worker as /data/sources.
SOURCES_DIR=./data/sources
ALLOWED_SOURCE_ROOTS=/data/sources

# Postgres container settings (must match DATABASE_URL).
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=agent_work

# Host ports.
API_PORT=8000
FRONTEND_PORT=5173
POSTGRES_PORT=5432
REDIS_PORT=6379

CORS_ORIGINS=http://localhost:5173
VITE_API_BASE_URL=http://localhost:8000
